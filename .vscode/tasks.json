{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "x64-debug"
      ],
      "group": "build"
    },
    {
      "label": "Build Debug x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "x64-debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": [
        "Configure Debug x64"
      ]
    },
    {
      "label": "Configure Release x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "x64-release"
      ],
      "group": "build"
    },
    {
      "label": "Build Release x64",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "x64-release"
      ],
      "group": "build",
      "dependsOn": [
        "Configure Release x64"
      ]
    }
  ]
}
